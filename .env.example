# Shared app configuration
NODE_ENV=development

# PostgreSQL / Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vedaa?schema=public"

# API runtime
PORT=4000
BETTER_AUTH_SECRET="replace-with-32-plus-character-secret"
BETTER_AUTH_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"

# Payment (test mode by default)
PAYMENT_MODE="development"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional image uploads (UploadThing token from the dashboard)
UPLOADTHING_TOKEN=""

# Web app
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
